{
	"name": "@ajwdmedia/svelterial-symbols-root",
	"version": "0.5.0",
	"private": true,
	"scripts": {
		"build": "vite build",
		"autoupdate": "node updater.js",
		"generate": "node generate.js",
		"pack": "node generate.js && svelte-package --types false",
		"push": "npm run pack && npm publish ./dist/light --access public -q && npm publish ./dist/regular --access public -q && npm publish ./dist/bold --access public -q"
	},
	"files": [
		"dist"
	],
	"exports": {
		"./bold": {
			"types": "./dist/bold.d.ts",
			"svelte": "./dist/bold.js"
		},
		"./regular": {
			"types": "./dist/regular.d.ts",
			"svelte": "./dist/regular.js"
		},
		"./light": {
			"types": "./dist/light.d.ts",
			"svelte": "./dist/light.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.55.1"
	},
	"type": "module",
	"devDependencies": {
		"@material-symbols/svg-200": "0.43.0",
		"@material-symbols/svg-400": "0.43.0",
		"@material-symbols/svg-700": "0.43.0",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^24.12.0",
		"@types/semver": "^7.8.0",
		"@types/svg-parser": "^2.0.6",
		"es-main": "^1.4.0",
		"semver": "^7.8.5",
		"svelte": "^5.55.1",
		"svg-parser": "^2.0.4",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"vite": "^8.0.3"
	}
}
