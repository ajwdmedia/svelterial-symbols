{
	"name": "@ajwdmedia/svelterial-symbols-root",
	"version": "0.4.0",
	"private": true,
	"scripts": {
		"generate": "node generate.js",
		"build": "vite build",
		"version:patch": "node version.js",
		"pack": "node generate.js && svelte-package --types false"
	},
	"files": [ "dist" ],
