		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^24.12.0",
		"@types/svg-parser": "^2.0.6",
		"svelte": "^5.55.1",
		"@sveltejs/package": "^2.5.7",
		"svg-parser": "^2.0.4",
		"typescript": "^5.9.3",
		"tslib": "^2.8.1",
		"vite": "^8.0.3",
		"@material-symbols/svg-200": "^0.43.0",
